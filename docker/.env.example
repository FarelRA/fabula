# Fabula self-host env. Copy to docker/.env and edit:
#   cp docker/.env.example docker/.env
#   docker compose --env-file docker/.env up -d --build

# --- pinned image tag (pin to a release tag once validated) -------------------
CONVEX_IMAGE_TAG=latest

# --- instance -----------------------------------------------------------------
INSTANCE_NAME=fabula
# openssl rand -base64 32
INSTANCE_SECRET=

# --- origins (use your https origins when the TLS overlay is enabled) ---------
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# --- ports (bound to 127.0.0.1; the TLS overlay is the public entry) ----------
APP_PORT=3000
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791

# --- optional TLS overlay (docker-compose.tls.yml, Traefik) -------------------
# TRAEFIK_IMAGE_TAG=v3.5
# ACME_EMAIL=ops@example.com
# APP_HOST=fabula.example.com
# CONVEX_HOST=api.fabula.example.com
# CONVEX_SITE_HOST=site.fabula.example.com

# --- optional Postgres upgrade (unset = local SQLite in the volume) ------------
# POSTGRES_URL=postgres://user:password@postgres:5432/fabula

# --- optional S3-compatible storage (unset = local filesystem) ------------------
# S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_STORAGE_FILES_BUCKET=fabula-files

# AI provider keys are NOT docker env: they live in the Convex deployment env
# (dashboard → Settings → Env, or `bunx convex env set` against the backend).
