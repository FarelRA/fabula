{
  "name": "fabula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Realtime roleplay platform with an all-AI cast and a human director.",
  "scripts": {
    "dev": "next dev",
    "dev:backend": "convex dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "check": "tsc --noEmit && eslint . --max-warnings 0 && vitest run",
    "seed": "tsx scripts/seed-dev.ts",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "terminology": "tsx scripts/check-terminology.ts",
    "selfhost:smoke": "tsx scripts/selfhost-smoke.ts",
    "dc:up": "docker compose --env-file docker/.env up -d",
    "dc:logs": "docker compose --env-file docker/.env logs -f",
    "dc:down": "docker compose --env-file docker/.env down"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/openai": "^4.0.96",
    "@convex-dev/agent": "^0.7.8",
    "@convex-dev/auth": "^0.0.96",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "convex": "^1.47.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "^15",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.62",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "jsdom": "^26",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
