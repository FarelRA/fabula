# Fabula — public (browser-readable) config. Copy to .env.local for local dev.
# Full env reference: PLAN.md §15.1 and docker/.env.example.

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_FIXTURES=0
NEXT_PUBLIC_APP_NAME=Fabula

# Server/backed-side env (AI keys, Convex deployment env: SITE_URL, JWT keys, model tiers,
# TTS_API_KEY at H3) lives on the Convex deployment — set with:
#   bunx convex env set KEY value
# Never put provider secrets in this file.
