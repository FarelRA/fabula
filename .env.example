# Public (browser-readable) config. Copy to .env.local for local dev.
# Full env reference: docker/.env.example and the self-host runbook.

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_FIXTURES=0
NEXT_PUBLIC_APP_NAME=Fabula

# Server-side env (AI keys plus the Convex deployment env: SITE_URL, JWT keys,
# model tiers, and the voice provider key) lives on the Convex deployment:
#   bunx convex env set KEY value
# Never put provider secrets in this file.
